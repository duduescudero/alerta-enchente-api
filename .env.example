# Copie para .env (que NÃO vai para o Git) e troque a senha.
# Mesma senha usada pelo docker-compose.yml para criar o banco.
POSTGRES_USER=alerta
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=alerta_enchente

DATABASE_URL=postgresql+psycopg://alerta:troque-esta-senha@localhost:5432/alerta_enchente

# Opcional: banco descartável para o teste de migrações (tests/test_migracoes.py).
# Ele é APAGADO e recriado a cada execução: nunca aponte para o banco principal.
# DATABASE_URL_TESTE=postgresql+psycopg://alerta:troque-esta-senha@localhost:5432/alerta_enchente_teste
